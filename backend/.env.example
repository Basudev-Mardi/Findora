# Server configuration
PORT=5000
NODE_ENV=development

# Allowed frontend origin for CORS
CORS_ORIGIN=http://localhost:3000

# Data mode: "demo" (local in-memory demo data) or "postgres" (Neon PostgreSQL)
# If DATABASE_URL is omitted, the backend automatically runs in demo mode.
DATA_MODE=demo

# Administrator API key for claim review & recovery confirmation
ADMIN_API_KEY=findora-admin-demo-key

# Optional Neon PostgreSQL connection string
# DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/findora?sslmode=require
